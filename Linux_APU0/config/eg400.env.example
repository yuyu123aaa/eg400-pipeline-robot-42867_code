# EG400 Linux application configuration template
# Replace YOUR_* values only after verifying them on the actual board.

EG400_MODEL_PATH=/opt/eg400/models/best.onnx
EG400_SAVE_DIR=/opt/eg400/data

# Web service
EG400_WEB_HOST=0.0.0.0
EG400_WEB_PORT=5000
EG400_WEB_ONLY=1
EG400_SIMULATION_MODE=1

# Deployment network contract. These values document the intended PS Ethernet
# endpoint and are consumed by deployment scripts/log output, not by Flask's
# bind address. The SD image must expose eth1 before it can use this contract.
EG400_PS_INTERFACE=eth1
EG400_PS_MAC=e0:78:a3:01:02:03
EG400_BOARD_IP=192.168.137.101
EG400_WINDOWS_IP=192.168.137.1

# Original project reference ports; verify before enabling real services.
CMD_PORT=9001
UDP_PORT=9998
GAMEPAD_PORT=9002

# Hardware values are intentionally unset until EG400 enumeration is verified.
CAMERA_DEVICE=YOUR_CAMERA_DEVICE
TEMP_SENSOR_PORT=YOUR_TEMP_SENSOR_DEVICE
RPMSG_CONTROL_DEVICE=YOUR_RPMSG_CONTROL_DEVICE
RPMSG_DATA_DEVICE=YOUR_RPMSG_DATA_DEVICE

# Safety: keep real actuator output disabled during migration.
EG400_HARDWARE_CONTROL_ENABLED=0
