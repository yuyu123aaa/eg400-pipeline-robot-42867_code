
# =====================================================================
#  ★ 2026-10-10 USB-only 裁剪：删除全部 MIPI 摄像头引脚约束
# =====================================================================
#  被删掉的 6 组（顶层 system_top.v 里对应的端口也已删除，
#  留着会报 "constraint refers to a non-existent port"）：
#
#    I_clk_hs_p          N18    LVDS18
#    I_data_hs_p[3:0]    N20 / R16 / N17 / T17   LVDS18 + INDEL=20
#    I_data_lp_p[3:0]    Y18 / V17 / Y16 / W18   LVCMOS18
#    I_data_lp_n[3:0]    Y19 / V18 / Y17 / W19   LVCMOS18
#    O_imax334_rst_n     V20    LVCMOS18
#    O_imx334_clk_24m    W20    LVCMOS18
#
#  副作用（好事）：这几个脚原来是 BANK32 的 1.8V(ADJ)，
#  删掉之后 BANK32 只剩 led[0]/led[1] 两个状态灯，不再有混压问题。
# =====================================================================


# =====================================================================
#  ★ 2026-10-10 新增：3 路 AXI UART Lite 的引脚约束
#      （UART-A 气体传感器 / UART-B 浑浊度传感器 / UART-C 超声波）
#  ★ 2026-10-30 新增：UART-D 前向超声波（CEP pin17/18）
#      （前向超声波的 32 板接口损坏，改为 FPGA 直连）
#
#  板卡：米联客 MLK-F3P-CZ02（DR1M90GEG400）
#  来源：08_框图及pinlist\MLK-F3P\PL-GPIO连接器管脚定义表.xlsx
#        08_框图及pinlist\MLK-F3P\PL-RS485管脚定义表.xlsx
#        器件 PINLIST：DR1M90_DR1V90GEG400_PINLIST.xlsx
#
#  ── 为什么全部用 LVCMOS33 ─────────────────────────────────────
#  按器件 PINLIST 查 BALL 归属：
#     CEP 排针 J12 的 24 个信号脚 → 全部在 BANK11（VCCIO_11）
#     RS485 的 L17 / N15 / N16    → 全部在 BANK33（VCCIO_33）
#  这两组 bank 在底板上都供 3.3V（与已在用的 Y12/Y13 等一致），
#  所以统一 LVCMOS33。BANK32 是 1.8V(ADJ)，本文件里只有 led[0]/led[1]。
#
#  ── CEP 排针 J12 占用总表（26 pin，pin1=VCC_CEP1 / pin2=GND）──────
#     pin3  Y12  i2c0_scl        pin4  Y13  i2c0_sda
#     pin5  T9   i2c1_scl        pin6  U10  i2c1_sda
#     pin7  T5   uart0_tx        pin8  U5   uart0_rx
#     pin9  V6   led1            pin10 W6   gas_pump    ← 2026-10-15 新增
#     pin11 U7   led2            pin12 V7   gas_valve   ← 2026-10-15 新增
#     pin13 U9   uart_ultra_tx   pin14 U8   uart_ultra_rx
#     pin15 V11  uart_gas_tx     pin16 V10  uart_gas_rx
#     pin17 Y7   uart_front_tx   ← 2026-10-30 前向超声波
#     pin18 Y6   uart_front_rx   ← 2026-10-30 前向超声波
#     pin19 Y9   —— 空闲         pin20 Y8   —— 空闲
#     pin21 V8   —— 空闲         pin22 W8   —— 空闲
#     pin23 W10  —— 空闲         pin24 W9   —— 空闲
#     pin25 W11  —— 空闲         pin26 Y11  —— 空闲
#     （还剩 10 个空闲信号脚备用；全部在 BANK11 / 3.3V）
# =====================================================================

# ---- UART-A：气体传感器（CEP 排针 pin15 / pin16）----
set_pin_assignment	{ uart_gas_tx }	{ LOCATION = V11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;   }
set_pin_assignment	{ uart_gas_rx }	{ LOCATION = V10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- UART-C：超声波（CEP 排针 pin13 / pin14）----
set_pin_assignment	{ uart_ultra_tx }	{ LOCATION = U9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;   }
set_pin_assignment	{ uart_ultra_rx }	{ LOCATION = U8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- UART-D：前向超声波（CEP 排针 pin17 / pin18）----
#  2026-10-30：前向超声波的 32 板接口损坏，改为 FPGA 直连。
#  TX -> 探头 RX，RX <- 探头 TX，必须交叉；探头 5V 供电，GND 共地。
#  ⚠️ 探头 TX 若是 5V 推挽，不能直接进 Y6；加分压/电平转换后再接。
set_pin_assignment	{ uart_front_tx }	{ LOCATION = Y7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;   }
set_pin_assignment	{ uart_front_rx }	{ LOCATION = Y6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- UART-B：浑浊度传感器 —— 走板载 RS485 收发器 U21（SP3485EN）----
#      链路：L17 → U21.DI(4)     发送
#            N16 ← U21.RO(1)     接收
#            N15 → U21.DE+RE(2/3) 收发使能（原理图上 DE 与 /RE 短接）
#            A(6)/B(7) → J11 端子，板载 R120=120R 终端电阻
set_pin_assignment	{ uart_turb_tx }	{ LOCATION = L17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ uart_turb_rx }	{ LOCATION = N16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ rs485_de }	{ LOCATION = N15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }


# =====================================================================
#  ★ 2026-09-26 我原工程 my_work 的 8 个外设引脚
#     端口名与顶层 system_top.v 的端口**一字不差**
#     球号与 CEP 排针与我原工程完全一致 → 接线不用改
# =====================================================================
# I2C0 → PCA9685 舵机板（CEP pin 3 / 4）
set_pin_assignment	{ i2c0_scl }	{ LOCATION = Y12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ i2c0_sda }	{ LOCATION = Y13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# I2C1 → CEP pin 5 / 6
set_pin_assignment	{ i2c1_scl }	{ LOCATION = T9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ i2c1_sda }	{ LOCATION = U10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# UART0 → PS EMIO 串口（CEP pin 7 / 8，注意 TX/RX 交叉）
set_pin_assignment	{ uart0_tx }	{ LOCATION = T5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;   }
set_pin_assignment	{ uart0_rx }	{ LOCATION = U5;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# 照明灯 1 / 2（PL_GPIO[0] / PL_GPIO[1]，CEP pin 9 / 11）
# PL_GPIO[2] 给了 RS485 的 rs485_de，见上面
set_pin_assignment	{ led1 }	{ LOCATION = V6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ led2 }	{ LOCATION = U7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# ---- ★ 2026-10-15 新增：气泵 / 电磁阀 继电器控制（PL_GPIO[3] / PL_GPIO[4]）----
#  选脚理由：这两颗正好是现有 led1(V6, pin9) / led2(U7, pin11) 的**邻里空闲脚**
#            ⇒ 四根控制线集中在 CEP 排针的 pin9~pin12 连续区间，接线不易插错。
#      CEP pin10  W6  —— 气泵  gas_pump  （PL_GPIO[4]）
#      CEP pin12  V7  —— 电磁阀 gas_valve（PL_GPIO[3]）
#
#  ⚠️ 两颗都在 BANK11（VCCIO_11），底板上供 3.3V ⇒ LVCMOS33。
#     不要挪到 BANK32 —— 那个 bank 是 1.8V(ADJ)，混压会烧 IO。
#     来源：08_框图及pinlist\MLK-F3P\PL-GPIO连接器管脚定义表.xlsx
#           器件 PINLIST：DR1M90_DR1V90GEG400_PINLIST.xlsx（400 封装上这两脚存在）
#
#  电平与驱动：8mA 推挽足够驱动 N-MOS 栅极（经限流电阻）。
#     PULLTYPE = NONE —— 外部硬件已有 10k 下拉到 GND 保证复位期间继电器断开，
#     这里再加内部上拉反而会在复位瞬间把栅极抬高，绝对不行。
#     ⚠️ 这两根是**常驱推挽输出**，在 system_top.v 里没有写成三态，别改。
set_pin_assignment	{ gas_pump  }	{ LOCATION = W6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ gas_valve }	{ LOCATION = V7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }


# =====================================================================
#  HDMI 输出 + LED 状态指示 —— 官方 Demo 原样保留
# =====================================================================
set_pin_assignment	{ O_hdmi_clk_p   }	{ LOCATION = K17; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[0] }	{ LOCATION = M14; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[1] }	{ LOCATION = F16; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_hdmi_tx_p[2] }	{ LOCATION = D19; IOSTANDARD = LVDS33_E; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment	{ led[0] }	{ LOCATION = T19;  IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[1] }	{ LOCATION = R19;  IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[2] }	{ LOCATION = J15;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
